generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Scheme {
  id           Int               @id @default(autoincrement())
  name         String
  description  String
  price        Int
  isAvailable  Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  roomTypeName String?
  images       Image[]
  orders       OrdersOnSchemes[]
  roomType     RoomType?         @relation(fields: [roomTypeName], references: [name], onDelete: Cascade)
}

model Image {
  id           Int       @id @default(autoincrement())
  url          String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  schemeId     Int
  roomTypeName String?
  schemeIndex  Int
  roomType     RoomType? @relation(fields: [roomTypeName], references: [name], onDelete: Cascade)
  scheme       Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)
}

model RoomType {
  name      String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  images    Image[]
  schemes   Scheme[]
}

model User {
  email         String   @unique
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isActive      Boolean  @default(false)
  emailConsent  Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  newsletterSub Boolean  @default(false)
  password      String?
  id            Int      @id @default(autoincrement())
  Order         Order[]
}

model Order {
  id               Int               @id @default(autoincrement())
  totalPrice       Int
  withConsultation Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userId           Int
  User             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  schemes          OrdersOnSchemes[]
}

model OrdersOnSchemes {
  schemeId  Int
  orderId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id])
  scheme    Scheme   @relation(fields: [schemeId], references: [id])

  @@id([schemeId, orderId])
}

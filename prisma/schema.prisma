generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Scheme {
  id           Int               @id @default(autoincrement())
  name         String
  description  String
  price        Int
  isAvailable  Boolean           @default(false)
  images       Image[]
  roomTypeName String?
  roomType     RoomType?         @relation(fields: [roomTypeName], references: [name], onDelete: Cascade)
  orders       OrdersOnSchemes[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Image {
  id           Int       @id @default(autoincrement())
  url          String
  schemeId     Int
  schemeIndex  Int
  scheme       Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  roomTypeName String?
  roomType     RoomType? @relation(fields: [roomTypeName], references: [name], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model RoomType {
  name      String   @id
  schemes   Scheme[]
  images    Image[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  name          String?
  password      String?
  isActive      Boolean  @default(false)
  newsletterSub Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id               Int               @id @default(autoincrement())
  totalPrice       Int
  schemes          OrdersOnSchemes[]
  userId           Int
  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  withConsultation Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model OrdersOnSchemes {
  schemeId  Int
  scheme    Scheme   @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([schemeId, orderId])
}
